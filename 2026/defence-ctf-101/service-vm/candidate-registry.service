[Unit]
Description=Candidate Registry (docker compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
WorkingDirectory=/root/candidate_registry
ExecStart=/usr/bin/docker compose up -d
# The first start builds the images, which takes minutes
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
